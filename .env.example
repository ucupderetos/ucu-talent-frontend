# Plantilla de variables de entorno. Copiala a .env.local y completá los valores.
#   cp .env.example .env.local
#
# .env.local está en .gitignore: NUNCA commitear credenciales ni tokens.
# Acá solo van placeholders.

# Base URL de la API de Spring Boot.
# Todo lo que sea NEXT_PUBLIC_* queda expuesto en el bundle del browser, así que
# esta variable no puede tener secretos — es solo una URL pública.
NEXT_PUBLIC_API_URL=http://localhost:8080

# ---------------------------------------------------------------------------
# Desarrollo sin backend (temporal)
# ---------------------------------------------------------------------------
# Mientras la API no exista, GET /me falla y los guards bloquean todas las rutas
# protegidas. Con esto simulás estar logueado y podés ver tus pantallas.
#
# Valores: alumno | empresa | admin — poné el rol de tu grupo.
# Descomentá SOLO en tu .env.local. Se borra cuando el backend esté listo.
#
# NEXT_PUBLIC_MOCK_SESSION=alumno
